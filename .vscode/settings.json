{
    "idf.currentSetup": "D:/Espressif/frameworks/esp-idf-v5.5.5/",
    "idf.adapterTargetName": "esp32s3",
    "idf.flashType": "UART",
    "idf.openOcdConfigs": [
        "board/esp32s3-builtin.cfg"
    ],
    "idf.enableIdfComponentManager": true,
    "idf.notificationMode": "All",

    "C_Cpp.intelliSenseEngine": "default",
    "C_Cpp.default.configurationProvider": "espressif.esp-idf-extension",

    "files.associations": {
        "*.c": "c",
        "*.h": "c"
    },
    "files.encoding": "utf8",

    "[c]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true
    },
    "idf.portWin": "COM17"
}
